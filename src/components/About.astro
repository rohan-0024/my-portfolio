---
import { about } from '../data/about';
const { portrait, story, activities } = about;
---
<section id="about" class="reveal">
  <div class="wrap">
    <p class="eyebrow">cat ./about.md</p>
    <h2>Before the first commit.</h2>
    <p class="intro dim">The changelog says what shipped. This is who was typing.</p>

    <div class="bio">
      <figure class="portrait" aria-hidden="false">
        <img src={portrait.src} alt={portrait.alt} width={portrait.width} height={portrait.height} loading="lazy" decoding="async" />
        <figcaption class="mono dim">rohan@paul <span class="dot"></span> uptime: since 2023</figcaption>
      </figure>

      <ol class="story">
        {story.map((c, i) => (
          <li class={i === story.length - 1 ? 'now' : ''}>
            <span class="when mono">{c.when}</span>
            <p>{c.text}</p>
          </li>
        ))}
      </ol>
    </div>

    <div class="off" data-off>
      <h3>Off the keyboard. <span class="dim">Except the one with 61 keys.</span></h3>
      <p class="hint mono dim">tap one</p>
      <ul class="acts" role="list">
        {activities.map((a) => (
          <li class={`act accent-${a.accent}`} data-act={a.id}>
            <button type="button" class="face" aria-expanded="false" aria-controls={`act-${a.id}`}>
              <span class="label">{a.label}</span>
              <span class="one dim">{a.one}</span>
              <span class="status mono">{a.status}</span>
            </button>
          </li>
        ))}
      </ul>
      <div class="panels">
        {activities.map((a) => (
          <div class="panel" id={`act-${a.id}`} data-panel={a.id} hidden>
            <div class={`shot accent-${a.accent}`}>
              {a.image ? (
                <img src={a.image.src} alt={a.image.alt} width={a.image.width} height={a.image.height} loading="lazy" decoding="async" />
              ) : (
                <svg class="keys" viewBox="0 0 420 160" role="img" aria-label="A row of piano keys">
                  <rect x="0" y="0" width="420" height="160" rx="10" fill="var(--ink-2)" />
                  {Array.from({ length: 14 }, (_, i) => (
                    <rect x={6 + i * 29.2} y="8" width="27" height="144" rx="3" fill="var(--ivory)" opacity={i === 7 ? 0.65 : 0.92} />
                  ))}
                  {[0, 1, 3, 4, 5, 7, 8, 10, 11, 12].map((i) => (
                    <rect x={6 + i * 29.2 + 19} y="8" width="18" height="88" rx="2" fill="var(--ink)" />
                  ))}
                  <circle cx={6 + 7 * 29.2 + 13.5} cy="130" r="5" fill="var(--accent)" />
                </svg>
              )}
            </div>
            <p class="caption">{a.caption}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-off]');
  if (root) {
    const faces = [...root.querySelectorAll<HTMLButtonElement>('.face')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    const open = (id: string | null) => {
      faces.forEach((f) => {
        const on = f.parentElement!.dataset.act === id;
        f.setAttribute('aria-expanded', String(on));
        f.parentElement!.classList.toggle('is-open', on);
      });
      panels.forEach((p) => {
        const on = p.dataset.panel === id;
        if (on && p.hidden) { p.hidden = false; p.classList.remove('in'); requestAnimationFrame(() => p.classList.add('in')); }
        else if (!on) { p.hidden = true; p.classList.remove('in'); }
      });
    };
    faces.forEach((f) => f.addEventListener('click', () => {
      const id = f.parentElement!.dataset.act!;
      open(f.getAttribute('aria-expanded') === 'true' ? null : id);
    }));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') open(null); });
  }
</script>

<style>
  .intro { max-width: 52ch; margin: 0 0 40px; }
  .bio { display: grid; grid-template-columns: minmax(180px, 260px) 1fr; gap: 40px clamp(32px, 6vw, 80px); align-items: start; }
  .portrait { margin: 0; position: sticky; top: 32px; }
  .portrait img {
    width: 100%; height: auto;
    /* Background baked to alpha at build time (see public/about), so it floats on the page ink. */
    filter: saturate(0.92) drop-shadow(0 30px 40px rgba(0,0,0,0.55));
    -webkit-mask-image: linear-gradient(to bottom, #000 82%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 82%, transparent 100%);
  }
  .portrait figcaption { margin-top: 10px; font-size: 0.74rem; display: flex; align-items: center; gap: 8px; }
  .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--mint); box-shadow: 0 0 10px var(--mint); }

  .story { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--rule); }
  .story li { display: grid; grid-template-columns: 4.5rem 1fr; gap: 16px; padding: 18px 0; border-bottom: 1px solid var(--rule); align-items: baseline; }
  .story .when { color: var(--butter); }
  .story li.now .when { color: var(--mint); }
  .story p { margin: 0; color: var(--ivory); line-height: 1.65; max-width: 60ch; }

  .off { margin-top: clamp(56px, 8vw, 96px); }
  h3 { font-size: clamp(1.3rem, 2.6vw, 1.8rem); margin-bottom: 6px; }
  h3 .dim { font-weight: 500; font-size: 0.78em; }
  .hint { margin: 0 0 18px; font-size: 0.76rem; }
  .acts { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  .face {
    width: 100%; text-align: left; display: grid; gap: 6px; min-height: 44px;
    padding: 18px 18px 14px; border-radius: 12px; border: 1px solid var(--rule); background: var(--ink-2);
    cursor: pointer; transition: border-color 160ms ease, transform 160ms ease, background 160ms ease;
  }
  .face:hover { border-color: var(--accent); transform: translateY(-2px); }
  .act.is-open .face { border-color: var(--accent); background: var(--ink-3); }
  .label { font-family: var(--font-display); font-weight: 600; font-size: 1.15rem; color: var(--ivory); }
  .act.is-open .label { color: var(--accent); }
  .one { font-size: 0.9rem; line-height: 1.4; }
  .status { font-size: 0.72rem; color: var(--accent); opacity: 0.85; margin-top: 4px; }
  .face::after { content: '+'; position: absolute; }
  .face { position: relative; }
  .face::after { top: 12px; right: 14px; font-family: var(--font-mono); color: var(--accent); transition: transform 220ms ease; }
  .act.is-open .face::after { transform: rotate(45deg); }

  .panel { margin-top: 14px; display: grid; grid-template-columns: minmax(0, 520px) 1fr; gap: 24px 32px; align-items: center; padding: 18px; border: 1px dashed var(--rule); border-radius: 14px; opacity: 0; transform: translateY(8px); transition: opacity 320ms ease, transform 320ms ease; }
  .panel.in { opacity: 1; transform: none; }
  .shot { border-radius: 10px; overflow: hidden; border: 1px solid var(--rule); background: var(--ink-2); }
  .shot img { width: 100%; height: auto; max-height: 440px; object-fit: cover; }
  .keys { width: 100%; height: auto; }
  .caption { margin: 0; color: var(--ivory); line-height: 1.7; max-width: 44ch; }

  @media (prefers-reduced-motion: reduce) { .panel { transition: none; transform: none; } .face:hover { transform: none; } }
  @media (max-width: 760px) {
    .bio { grid-template-columns: 1fr; gap: 28px; }
    .portrait { position: static; width: min(52%, 200px); margin-inline: auto; }
    .portrait figcaption { justify-content: center; }
    .story li { grid-template-columns: 1fr; gap: 4px; }
    .acts { grid-template-columns: 1fr; }
    .panel { grid-template-columns: 1fr; padding: 12px; }
  }
</style>
