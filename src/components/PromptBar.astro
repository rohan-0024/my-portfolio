---
/**
 * Sticky prompt bar. Appears once the hero nav scrolls away and shows where you are as a shell path:
 *   rohan@paul:~/about $
 * Tap the path to get a `cd` menu for every section, so no one has to scroll back to the top.
 */
const sections = [
  { id: 'top', label: '~', cmd: 'cd ~', title: 'home' },
  { id: 'changelog', label: 'changelog', cmd: 'cd changelog' },
  { id: 'work', label: 'work', cmd: 'cd work' },
  { id: 'stack', label: 'stack', cmd: 'cd stack' },
  { id: 'connectome', label: 'connectome', cmd: 'cd connectome' },
  { id: 'about', label: 'about', cmd: 'cd about' },
  { id: 'contact', label: 'contact', cmd: 'cd contact' },
];
---
<div class="pbar mono" data-pbar hidden aria-label="Section navigation">
  <div class="wrap row">
    <button type="button" class="path" data-pbar-toggle aria-expanded="false" aria-controls="pbar-menu" title="Jump to a section">
      <span class="dim">rohan@paul:</span><span class="cwd">~<span data-pbar-cwd></span></span><span class="dim"> $</span><span class="caret" aria-hidden="true"></span>
      <span class="chev" aria-hidden="true">▾</span>
    </button>
    <div class="right">
      <a class="up" href="#top" data-pbar-go="top" title="Back to top">cd ..</a>
      <button type="button" class="term-btn" data-open-terminal aria-label="Open terminal" title="Open terminal (press /)">&gt;_</button>
    </div>
  </div>
  <div class="menu wrap" id="pbar-menu" data-pbar-menu hidden>
    <ul role="list">
      {sections.map((s) => (
        <li><a href={`#${s.id}`} data-pbar-go={s.id}><span class="dim">$ </span>{s.cmd}<span class="now mono" data-pbar-now={s.id} hidden>  ← you are here</span></a></li>
      ))}
      <li><a href="/resume"><span class="dim">$ </span>man rohan</a></li>
    </ul>
  </div>
</div>

<script>
  const bar = document.querySelector<HTMLElement>('[data-pbar]');
  if (bar) {
    const toggle = bar.querySelector<HTMLButtonElement>('[data-pbar-toggle]')!;
    const menu = bar.querySelector<HTMLElement>('[data-pbar-menu]')!;
    const cwd = bar.querySelector<HTMLElement>('[data-pbar-cwd]')!;
    const heroNav = document.querySelector<HTMLElement>('.hero .nav');
    const sections = [...document.querySelectorAll<HTMLElement>('section[id]')];
    const reduced = () => matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Show the bar once the hero's own nav has scrolled out of view.
    let shown = false;
    const show = (on: boolean) => {
      if (on === shown) return;
      shown = on;
      if (on) { bar.hidden = false; requestAnimationFrame(() => bar.classList.add('in')); }
      else { bar.classList.remove('in'); closeMenu(); setTimeout(() => { if (!shown) bar.hidden = true; }, reduced() ? 0 : 260); }
    };
    if (heroNav) new IntersectionObserver(([e]) => show(!e.isIntersecting && e.boundingClientRect.top < 0), { threshold: 0 }).observe(heroNav);
    else show(true);

    // Current section = the last one whose top has passed the upper third of the viewport.
    let current = 'top';
    const setCurrent = (id: string) => {
      if (id === current) return;
      current = id;
      cwd.textContent = id === 'top' ? '' : `/${id}`;
      bar.querySelectorAll<HTMLElement>('[data-pbar-now]').forEach((el) => { el.hidden = el.dataset.pbarNow !== id; });
      bar.querySelectorAll<HTMLElement>('[data-pbar-go]').forEach((a) => a.classList.toggle('is-now', a.dataset.pbarGo === id));
    };
    const update = () => {
      const line = innerHeight * 0.34;
      let id = 'top';
      for (const s of sections) if (s.getBoundingClientRect().top <= line) id = s.id;
      setCurrent(id);
    };
    let ticking = false;
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(() => { ticking = false; update(); }); } }, { passive: true });
    update();

    // Menu
    const openMenu = () => { menu.hidden = false; toggle.setAttribute('aria-expanded', 'true'); bar.classList.add('open'); };
    const closeMenu = () => { menu.hidden = true; toggle.setAttribute('aria-expanded', 'false'); bar.classList.remove('open'); };
    toggle.addEventListener('click', () => (menu.hidden ? openMenu() : closeMenu()));
    document.addEventListener('click', (ev) => { if (!bar.contains(ev.target as Node)) closeMenu(); });
    document.addEventListener('keydown', (ev) => { if (ev.key === 'Escape' && !menu.hidden) { closeMenu(); toggle.focus(); } });
    bar.addEventListener('click', (ev) => {
      const a = (ev.target as HTMLElement).closest<HTMLElement>('[data-pbar-go]');
      if (!a) return;
      ev.preventDefault();
      const id = a.dataset.pbarGo!;
      closeMenu();
      const target = document.getElementById(id);
      if (id === 'top' || !target) scrollTo({ top: 0, behavior: reduced() ? 'auto' : 'smooth' });
      else target.scrollIntoView({ behavior: reduced() ? 'auto' : 'smooth', block: 'start' });
      history.replaceState(null, '', id === 'top' ? location.pathname : `#${id}`);
    });
  }
</script>

<style>
  .pbar {
    position: fixed; inset: 0 0 auto 0; z-index: 40;
    background: rgba(10, 10, 12, 0.96); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--rule);
    transform: translateY(-100%); opacity: 0;
    transition: transform 260ms ease, opacity 260ms ease;
    font-size: 0.8rem;
  }
  .pbar.in { transform: none; opacity: 1; }
  .row { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 48px; }
  .path {
    display: inline-flex; align-items: center; gap: 0; min-height: 36px; padding: 0 10px 0 0;
    background: none; border: 0; color: var(--ivory); font: inherit; cursor: pointer; white-space: nowrap; text-align: left;
    max-width: 100%; overflow: hidden; text-overflow: ellipsis;
  }
  .cwd { color: var(--mint); }
  .caret { display: inline-block; width: 0.55em; height: 1em; margin-left: 6px; background: var(--coral); animation: blink 1.1s steps(1) infinite; transform: translateY(0.1em); }
  @keyframes blink { 50% { opacity: 0; } }
  .chev { margin-left: 10px; color: var(--ivory-dim); font-size: 0.7em; transition: transform 200ms ease; }
  .pbar.open .chev { transform: rotate(180deg); }
  .right { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
  .up { color: var(--ivory-dim); text-decoration: none; padding: 8px 6px; }
  .up:hover { color: var(--ivory); }
  .term-btn { min-width: 34px; min-height: 30px; padding: 0 8px; border-radius: 6px; border: 1px solid var(--rule); background: transparent; color: var(--mint); font-family: var(--font-mono); font-size: 0.8rem; cursor: pointer; }
  .term-btn:hover { border-color: var(--mint); }

  .menu { padding-bottom: 10px; }
  .menu ul { list-style: none; margin: 0; padding: 6px 0 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 2px 18px; border-top: 1px dashed var(--rule); }
  .menu a { display: block; padding: 9px 8px; border-radius: 6px; color: var(--ivory); text-decoration: none; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .menu a:hover { background: var(--ink-2); }
  .menu a.is-now { color: var(--mint); }
  .now { color: var(--ivory-dim); font-size: 0.72rem; white-space: pre; }

  @media (prefers-reduced-motion: reduce) { .pbar { transition: none; } .caret { animation: none; } .chev { transition: none; } }
  @media (max-width: 560px) {
    .pbar { font-size: 0.76rem; }
    .row { min-height: 44px; }
    .menu ul { grid-template-columns: 1fr 1fr; }
    .now { display: none; }
  }
</style>
