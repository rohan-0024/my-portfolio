---
---
<div class="term" data-terminal hidden role="dialog" aria-label="Terminal" aria-modal="false">
  <div class="bar mono">
    <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="title">rohan@dev: ~</span>
    <button type="button" class="close" data-term-close aria-label="Close terminal">esc</button>
  </div>
  <div class="out" data-term-out aria-live="polite"></div>
  <form class="line mono" data-term-form autocomplete="off">
    <label for="term-input" class="ps1"><span class="dim">rohan@dev</span>:<span class="path">~</span>$</label>
    <input id="term-input" data-term-input type="text" spellcheck="false" autocapitalize="off" autocorrect="off" placeholder="type help" aria-label="Command" />
  </form>
</div>

<script>
  import { initTerminal } from '../scripts/terminal';
  initTerminal();
</script>

<style>
  .term {
    position: fixed;
    left: 50%;
    bottom: calc(16px + env(safe-area-inset-bottom));
    transform: translateX(-50%);
    width: min(760px, calc(100vw - 32px));
    max-height: min(60vh, 520px);
    display: flex;
    flex-direction: column;
    z-index: 50;
    border: 1px solid var(--rule);
    border-radius: 12px;
    background: rgba(14, 14, 17, 0.96);
    backdrop-filter: blur(10px);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.6);
    font-size: 0.9rem;
    overflow: hidden;
  }
  .term[hidden] { display: none; }
  .bar { display: flex; align-items: center; gap: 12px; padding: 10px 12px; border-bottom: 1px solid var(--rule); font-size: 0.76rem; color: var(--ivory-dim); }
  .dots { display: inline-flex; gap: 6px; }
  .dots i { width: 10px; height: 10px; border-radius: 50%; background: var(--rule); }
  .dots i:first-child { background: var(--coral); }
  .dots i:nth-child(2) { background: var(--butter); }
  .dots i:last-child { background: var(--mint); }
  .title { flex: 1; }
  .close { border: 1px solid var(--rule); background: transparent; color: var(--ivory-dim); border-radius: 4px; padding: 2px 8px; font-family: var(--font-mono); font-size: 0.72rem; cursor: pointer; min-height: 28px; }
  .close:hover { color: var(--ivory); }
  .out { flex: 1; overflow-y: auto; padding: 14px 16px; font-family: var(--font-mono); line-height: 1.6; white-space: pre-wrap; word-break: break-word; scrollbar-width: thin; scrollbar-color: var(--rule) transparent; }
  .out:empty { display: none; }
  .out :global(.cmd) { color: var(--ivory); }
  .out :global(.cmd::before) { content: 'rohan@dev:~$ '; color: var(--ivory-dim); }
  .out :global(.res) { color: var(--ivory-dim); }
  .out :global(.ok) { color: var(--mint); }
  .out :global(.warn) { color: var(--butter); }
  .out :global(.err) { color: var(--coral); }
  .out :global(.hl) { color: var(--lavender); }
  .out :global(a) { color: var(--mint); }
  .line { display: flex; align-items: center; gap: 10px; padding: 12px 16px; border-top: 1px solid var(--rule); }
  .ps1 { white-space: nowrap; color: var(--ivory); }
  .path { color: var(--lavender); }
  input { flex: 1; min-width: 0; background: transparent; border: 0; outline: 0; color: var(--ivory); font-family: var(--font-mono); font-size: 16px; caret-color: var(--coral); padding: 6px 0; }
  input::placeholder { color: rgba(243, 239, 228, 0.3); }
  @media (max-width: 560px) {
    .term { bottom: calc(10px + env(safe-area-inset-bottom)); width: calc(100vw - 20px); max-height: 70vh; font-size: 0.84rem; }
    .ps1 .dim { display: none; }
  }
</style>
